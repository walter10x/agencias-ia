# === Base de datos (Postgres local via PostgREST) ===
# NOTA: el nombre SUPABASE_* es legado del cliente HTTP estilo PostgREST.
# NO usamos Supabase cloud. En Docker Compose apuntar al proxy interno:
SUPABASE_URL=http://postgrest-proxy:3000
SUPABASE_SERVICE_KEY=local-no-auth-needed

# === LLM Providers ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# === LLM Provider (agnostic) ===
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Para Anthropic Claude:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-sonnet-20240620

# Para Ollama local:
# LLM_PROVIDER=ollama
# LLM_API_KEY=not-needed
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3

# === WhatsApp Cloud API (Meta) — legacy / fallback ===
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=my-verify-token
WHATSAPP_API_VERSION=v22.0

# Canal activo: meta | ycloud
WHATSAPP_PROVIDER=ycloud

# === YCloud (BSP + Coexistence) ===
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
YCLOUD_API_BASE_URL=https://api.ycloud.com
# Número E.164 del negocio (from) — ej. +34682743315
YCLOUD_FROM_NUMBER=

# WhatsApp del equipo (alerta al agendar demo). Vacío = desactivado.
# Ej. +34602438307
TEAM_NOTIFY_WHATSAPP=

# === n8n Automatización ===
N8N_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key

# === Redis / Celery ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Frecuencia (minutos) del job periódico de recordatorios de cita (Fase 4).
# Debe coincidir con el intervalo configurado en el beat_schedule de
# celery_app.py — la tarea usa este mismo valor como ancho de la ventana
# de selección de citas (sin huecos ni duplicados entre ejecuciones).
# Requiere un proceso `celery beat` corriendo además del worker.
REMINDER_BEAT_INTERVAL_MINUTES=10

# === Seguridad ===
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Clave Fernet para cifrar el access_token de WhatsApp por tenant (Fase 3).
# Generar con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Vacío = fallback base64 INSEGURO solo-dev (ver
# app/infrastructure/security/credentials_cipher.py). NUNCA dejar vacío
# en producción ni versionar un valor real.
CREDENTIALS_ENCRYPTION_KEY=

# === App ===
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
